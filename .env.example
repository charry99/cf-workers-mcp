# Copy these into your MCP client config's "env" block (see README.md).
# Never commit a real token anywhere.

# Required for list_workers / get_worker / list_versions / list_deployments.
# Create it in the Cloudflare dashboard: My Profile -> API Tokens ->
# Create Token -> Custom token -> Permissions: Account -> Workers Scripts
# -> Read. Scope it to the one account you want to inspect.
CF_API_TOKEN=

# Optional: default account ID (32 hex characters, Dashboard -> Workers
# & Pages -> right-hand panel). Tools also accept account_id per call.
CF_ACCOUNT_ID=

# Optional: override the API base URL (testing only).
# CF_API_BASE_URL=https://api.cloudflare.com/client/v4
